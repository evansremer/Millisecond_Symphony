// BT24 UART. Existing PCM5102, TinyF, USB and JTAG pins unchanged.
IO_LOC "bt_rx" B16; // J13-9: module TX -> FPGA
IO_PORT "bt_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "bt_tx" B15; // J13-10: module RX <- FPGA
IO_PORT "bt_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4 BANK_VCCIO=3.3;
